# ---- LLM: OpenRouter（OpenAI 兼容）。密钥只放 .env（已 gitignore），不要提交 ----
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# 可留空：cortex 启动时经 GET /models 自动解析免费 "alpha" 模型并缓存
LLM_MODEL_ID=
LLM_TIMEOUT=120
# 双档：留空则都指向自动解析的模型；可分别覆盖
STRONG_MODEL_ID=
WEAK_MODEL_ID=
STRONG_TEMPERATURE=0.3
STRONG_TIMEOUT=120
WEAK_TEMPERATURE=0.0
WEAK_TIMEOUT=60

# ---- Embeddings（OpenRouter 不提供 /embeddings）----
# local | openai_compat | hash(仅测试)
CORTEX_EMBED_PROVIDER=local
CORTEX_EMBED_MODEL=BAAI/bge-small-zh-v1.5
OPENAI_COMPAT_EMBED_URL=
OPENAI_COMPAT_EMBED_KEY=
# 模型首次下载完成后建议打开：跳过 HF Hub 在线校验，
# 否则直连 huggingface.co 劣化时，每次 embedding 都要吃一轮 5 连重试
HF_HUB_OFFLINE=
TRANSFORMERS_OFFLINE=

# ---- 存储：local（零 docker，qdrant 本地模式+networkx 图）| docker ----
CORTEX_STORE_MODE=local
CORTEX_DATA_DIR=data
QDRANT_LOCAL_PATH=data/qdrant_local
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cortex-dev-pw

# ---- RAG ----
CORTEX_CHUNK_SIZE=512
CORTEX_CHUNK_OVERLAP=64
CORTEX_RETRIEVAL_MIN_SCORE=0.3
CORTEX_MQE_VARIANTS=3
# 开启交叉编码重排需先安装可选依赖：pip install -e ".[rerank]"（未装则软降级纯 RRF）
CORTEX_ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- 记忆 ----
CORTEX_MEMORY_W_SIMILARITY=0.6
CORTEX_MEMORY_W_IMPORTANCE=0.25
CORTEX_MEMORY_W_RECENCY=0.15
CORTEX_MEMORY_DECAY_LAMBDA=0.05
CORTEX_MEMORY_FORGET_IMPORTANCE=0.2
CORTEX_MEMORY_TIME_FORGET_DAYS=30
CORTEX_MEMORY_TIME_FORGET_IMPORTANCE=0.5
CORTEX_MEMORY_CAPACITY=5000
CORTEX_MEMORY_ASYNC_WRITES=true
CORTEX_PROCEDURAL_MEMORY_ENABLED=false

# ---- 协议（P6）----
# JSON 数组；每项必须含 name + transport(stdio|http|sse)，stdio 另需 command(+args)。
# 例：[{"name":"fetch","transport":"stdio","command":"uvx","args":["mcp-server-fetch"],
#      "env":{"npm_config_cache":"/tmp/npm-cache-cortex","HTTPS_PROXY":"http://127.0.0.1:7890"}}]
# 提示：fetch 服务器依赖 readabilipy，首次调用会在其目录 npm install——
# ~/.npm 缓存属主异常时务必注入可写的 npm_config_cache。
CORTEX_MCP_SERVERS=
CORTEX_A2A_RESEARCHER_URL=

# ---- 流水线阶段超时（秒；0=不限时）----
# 总阶段超时（兼容旧行为，默认 900s）
CORTEX_STAGE_TIMEOUT=900
# 各阶段独立超时（优先级高于全局；0=沿用全局）
# 建议：write 给更长（如 1800），research 次之；critique/revise 可短些
CORTEX_STAGE_TIMEOUT_GATHER=0
CORTEX_STAGE_TIMEOUT_RESEARCH=0
CORTEX_STAGE_TIMEOUT_WRITE=1800
CORTEX_STAGE_TIMEOUT_CRITIQUE=300
CORTEX_STAGE_TIMEOUT_REVISE=600

# ---- HTTP API ----
# X-API-Key 头校验；留空 = 不鉴权（仅开发）
API_KEY=
# 允许跨域的前端来源（逗号分隔，如 http://localhost:5173）；留空 = 不启用 CORS
CORTEX_CORS_ORIGINS=

# ---- 测试门禁：设为 1 才会跑 e2e live 用例 ----
HAS_LLM_KEY=
